# --- Public site ---------------------------------------------------------
# Absolute origin of the deployment. Used for canonical URLs, OG tags and QR codes.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Address shown on the privacy and terms pages for data and legal requests.
# Leave blank only in development: the pages show a visible warning without it.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Supabase ------------------------------------------------------------
# Project URL and anon key are safe to expose to the browser (RLS enforced).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key bypasses RLS. Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Anthropic -----------------------------------------------------------
# Powers the onboarding interview and the import-from-URL extractor.
ANTHROPIC_API_KEY=sk-ant-...

# Most model calls allowed per UTC day across all visitors (setup chat turns
# plus imports). Also set a monthly spend limit in the Anthropic console.
AI_DAILY_REQUEST_LIMIT=1500

# --- Email (Resend) ------------------------------------------------------
# Emails owners when an enquiry arrives. Leave both blank to disable: enquiries
# still appear in the dashboard, owners just aren't told.
RESEND_API_KEY=
# Must use a domain you have verified in Resend, e.g.
# BizPage <notifications@yourdomain.com>
EMAIL_FROM=
